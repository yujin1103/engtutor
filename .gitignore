# --- 비밀정보 (절대 커밋 금지) ---
.env
*.pem
*.key
.oci/

# --- 데이터 (로컬 생성물) ---
# 런타임 생성물만. content/data/ 는 소스라 루트에만 앵커링한다.
/data/
# 내려받은 모델 가중치. compose 는 named volume 을 쓰지만, 컨테이너 없이 돌리거나
# STT_MODEL_DIR 을 저장소 안으로 바꾸는 경우를 대비해 막아 둔다 — small 만 500MB 다.
/models/
*.db
*.db-journal
*.sqlite3

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Streamlit ---
.streamlit/secrets.toml

# --- OS / 에디터 ---
Thumbs.db
.DS_Store
.vscode/
.idea/

# 검수 배치 임시 파일 (레포에 넣지 않는다)
/.review/

# 터널 개인키 (절대 커밋 금지)
/deploy/keys/

# --- 폰용 React 클라이언트 (ui_web) ---
# 의존성. 파일이 수만 개다. compose 는 named volume 에 두지만, 호스트에서
# 직접 npm 을 돌린 경우를 대비해 막아 둔다.
ui_web/node_modules/
# 빌드 결과. FastAPI 가 `/` 로 서빙하는 그것이지만 소스가 아니라 산출물이다
# (`docker compose run --rm web npm run build` 로 언제든 다시 만든다).
ui_web/dist/
