# ===== LLM 백엔드 =====
# ollama    : 로컬 GPU (개발·평소 사용)
# anthropic : Claude API (데모·고품질)
LLM_BACKEND=ollama

# ===== Ollama =====
# 컨테이너에서 접근:  http://ollama:11434          (docker compose 기본)
# 호스트 Ollama 사용: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m

# ===== Anthropic =====
# 키는 여기(.env)에만 둔다. .env 는 .gitignore 에 있다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ===== 앱 =====
DB_PATH=./data/engtutor.db
API_BASE_URL=http://api:8000
REQUEST_TIMEOUT=120
