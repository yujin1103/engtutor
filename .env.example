# ===== LLM 백엔드 =====
# ollama    : 로컬 GPU (개발·평소 사용)
# anthropic : Claude API (데모·고품질)
LLM_BACKEND=ollama

# ===== Ollama =====
# 컨테이너에서 접근:  http://ollama:11434          (docker compose 기본)
# 호스트 Ollama 사용: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m

# ===== Anthropic =====
# 키는 여기(.env)에만 둔다. .env 는 .gitignore 에 있다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ===== 음성 입력 (STT) =====
# 값의 근거는 app/stt/service.py 에 측정 수치와 함께 적혀 있다. 바꾸기 전에 읽을 것.
STT_ENABLED=true
# small 로 고정한 이유: base 는 없는 말을 지어내 붙이고, large-v3 는 학습자의
# 오류를 가장 많이 지운다. 이 앱은 오류가 살아 있어야 교정해 줄 수 있다.
STT_MODEL=small
# 전사 정확도는 장치와 무관하다 — GPU 는 속도만 바꾼다. GPU 는 ollama 몫으로 둔다.
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# 모델 파일이 놓이는 곳. docker-compose.yml 의 whisper_models 볼륨이 여기 붙는다.
# (컨테이너 밖에서 직접 돌린다면 ./data/whisper 같은 로컬 경로로 바꾼다)
STT_MODEL_DIR=/models/whisper
# 업로드 상한(MB). 넘으면 413. 긴 파일 하나가 CPU 를 오래 붙잡는 것을 막는다.
STT_MAX_UPLOAD_MB=10

# ===== 앱 =====
DB_PATH=./data/engtutor.db
API_BASE_URL=http://api:8000
REQUEST_TIMEOUT=120

# ===== 외부 노출 (선택) =====
# 시범으로 남에게 보여줄 때만. docker compose --profile expose up -d tunnel
# 클라우드는 진입점으로만 쓴다 — 연산은 전부 이 집 GPU 에서 돈다.
TUNNEL_HOST=                    # Oracle VM 의 도메인 (예: engtutor.duckdns.org)
TUNNEL_USER=ubuntu
TUNNEL_KEY=id_ed25519           # deploy/keys/ 아래의 개인키 파일 이름
TUNNEL_REMOTE_PORT=8501         # VM 의 127.0.0.1 에 묶일 포트. nginx 가 여기로 넘긴다
# 터널이 무엇을 내보낼지. 기본은 api:8000 — FastAPI 가 `/` 로 React 앱을 주고
# 그 아래로 API 를 준다. 같은 출처여야 CORS 가 없고, 폰 브라우저가 HTTPS
# 아래에서만 마이크를 내주기 때문에 인증서 한 장으로 둘 다 해결된다.
# 데스크톱용 Streamlit 을 대신 내보내려면 ui:8501 로 바꾼다 (VM 쪽 nginx 는 그대로).
TUNNEL_TARGET=api:8000
