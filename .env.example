# ===== LLM 백엔드 =====
# ollama    : 로컬 GPU (개발·평소 사용)
# anthropic : Claude API (데모·고품질)
LLM_BACKEND=ollama

# ===== Ollama =====
# 컨테이너에서 접근:  http://ollama:11434          (docker compose 기본)
# 호스트 Ollama 사용: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m

# ===== Anthropic =====
# 키는 여기(.env)에만 둔다. .env 는 .gitignore 에 있다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ===== 앱 =====
DB_PATH=./data/engtutor.db
API_BASE_URL=http://api:8000
REQUEST_TIMEOUT=120

# ===== 외부 노출 (선택) =====
# 시범으로 남에게 보여줄 때만. docker compose --profile expose up -d tunnel
# 클라우드는 진입점으로만 쓴다 — 연산은 전부 이 집 GPU 에서 돈다.
TUNNEL_HOST=                    # Oracle VM 의 도메인 (예: engtutor.duckdns.org)
TUNNEL_USER=ubuntu
TUNNEL_KEY=id_ed25519           # deploy/keys/ 아래의 개인키 파일 이름
TUNNEL_REMOTE_PORT=8501         # VM 의 127.0.0.1 에 묶일 포트. nginx 가 여기로 넘긴다
